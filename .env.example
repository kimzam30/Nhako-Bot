# Copy to .env and fill in. Only the Telegram pair is required; every integration
# left empty is simply switched off (the bot tells you how to set it up).
# Inside Docker, compose.yaml overrides OLLAMA_HOST, DOCKER_PROXY_URL and MC_SERVERS.

# --- Telegram (required) ---
# From @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram user id (ask @userinfobot). Everyone else is ignored.
ALLOWED_USER_ID=your_telegram_user_id_here

# --- Ollama (runs natively on Windows with the GPU) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Must be pulled first: ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_NUM_CTX=4096
# Seconds before a model call is given up
OLLAMA_TIMEOUT=120
# How long the model stays loaded after a message (Ollama duration: 30m, 1h, -1 = forever)
OLLAMA_KEEP_ALIVE=30m

# --- Time ---
TIMEZONE=Asia/Kuala_Lumpur
# Morning agenda message (24h HH:MM), or "off"
AGENDA_TIME=08:00

# --- Homelab ---
# name=host:port, comma-separated. The names are what you call the servers in chat.
MC_SERVERS=getgud=127.0.0.1:25565
# Servers that should always be up: alert if they stop answering
MC_ALERT_SERVERS=getgud
# Read-only Docker socket proxy (set by compose.yaml; leave empty when running locally)
DOCKER_PROXY_URL=
# Alert when a container crashes or turns unhealthy, or Ollama goes down (a clean `docker stop` never alerts)
ALERTS=true
# Containers to never alert about, comma-separated
ALERT_IGNORE=

# --- Notion tasks (optional) ---
# notion.so/profile/integrations -> New integration (Internal) -> copy the secret (ntn_...)
NOTION_TOKEN=
# Your tasks database: its URL or id. Then on the database page: ••• -> Connections -> add the integration.
# If it has a relation to a projects database, the bot finds that too (share it with the integration as well).
NOTION_TASKS_DB=
# Week in review (tasks cleared, XP, projects, what's overdue): "day HH:MM", or "off"
WEEKLY_REVIEW=sun 20:00
# Daily ping for tasks that just went overdue (each one only once), 24h HH:MM, or "off"
OVERDUE_NUDGE_TIME=18:00

# --- Postiz (optional) ---
# The backend URL (NEXT_PUBLIC_BACKEND_URL in Postiz's own config), ending in /api
POSTIZ_URL=
# Postiz -> Settings -> Public API. The bot only lists posts and saves drafts.
POSTIZ_API_KEY=

# --- Google Calendar (optional) ---
# Both files live in DATA_DIR. See README: run scripts/google_auth.py once.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Voice, memory, storage ---
# faster-whisper size for voice notes: tiny, base, small (bigger = slower, more RAM)
WHISPER_MODEL=base
# Recent messages given to the model as conversation context
HISTORY_TURNS=6
# Messages kept per chat in the database; older ones are deleted daily
HISTORY_KEEP=200
# Where the database, Google token and whisper cache live
DATA_DIR=data
