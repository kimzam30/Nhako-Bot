# --- Telegram ---
TELEGRAM_TOKEN=ur_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# --- PostgreSQL + pgvector (SRC/memory.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bot_memory
DB_USER=nhako
DB_PASS=your_database_password_here

# --- Ollama ---
# Must be pulled separately: ollama pull nomic-embed-text
# Produces 768-dimension vectors, matching VECTOR(768) in the schema.
EMBEDDING_MODEL=nomic-embed-text
