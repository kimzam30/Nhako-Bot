# --- Telegram ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram user id (ask @userinfobot). Everyone else is ignored.
ALLOWED_USER_ID=your_telegram_user_id_here

# --- Ollama (runs natively on Windows, see docs/REVIVAL_PLAN.md) ---
# compose.yaml overrides this to http://host.docker.internal:11434 inside the container.
OLLAMA_HOST=http://127.0.0.1:11434
# Picked by scripts/bench.py in Phase 0. Must be pulled: ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_NUM_CTX=4096

# --- Misc ---
TIMEZONE=Asia/Kuala_Lumpur
# Morning agenda message (24h time), or "off"
AGENDA_TIME=08:00
# --- Homelab (Phase 4) ---
# compose.yaml sets MC_SERVERS and DOCKER_PROXY_URL for the container.
# Servers that should always be up: alert if they stop answering
MC_ALERT_SERVERS=getgud
# Alert when a container crashes or turns unhealthy (a clean `docker stop` never alerts)
ALERTS=true
# Containers to never alert about, comma-separated
ALERT_IGNORE=


# --- Notion tasks (Phase 5) ---
# notion.so/profile/integrations -> New integration (Internal) -> copy the secret (ntn_...)
NOTION_TOKEN=
# Your tasks database: its URL or id. Then on the database page: ••• -> Connections -> add the integration.
NOTION_TASKS_DB=

# --- Postiz (Phase 5) ---
# The backend URL (NEXT_PUBLIC_BACKEND_URL in Postiz's own config), ending in /api
POSTIZ_URL=https://postiz.example.com/api
# Postiz -> Settings -> Public API. The bot only lists posts and saves drafts.
POSTIZ_API_KEY=

# faster-whisper size for voice notes: tiny, base, small (bigger = slower, more RAM)
WHISPER_MODEL=base
# Where the database, Google token and whisper cache live
DATA_DIR=data
